# Variables para Railway (Settings → Variables). NO pongas valores reales en este archivo.

# JSON completo de la cuenta de servicio de Google (contenido de config/credentials.json, en una sola línea)
GOOGLE_CREDENTIALS_JSON={"type":"service_account", ...}

# Llave para firmar la sesión (64 caracteres al azar): python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# Hash de la clave de administrador: copia el valor "password_hash" de config/admin.json
ADMIN_PASSWORD_HASH=

# Usuario y contraseña que pide el navegador para entrar al dashboard
DASHBOARD_USER=bitelit
DASHBOARD_PASSWORD=

# Railway sirve por HTTPS
SESSION_COOKIE_SECURE=true

# Railway monta los volúmenes como root y la imagen corre con un usuario sin privilegios:
# esta variable le permite escribir en el volumen. (En AWS no se usa.)
RAILWAY_RUN_UID=0

# Carpeta del volumen persistente (IDs de hojas editados y caché). Monta un Volume en /state
BITELIT_STATE_DIR=/state
